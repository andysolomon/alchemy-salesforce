# Copy to an untracked env file and pass it with `--env-file`.
# Do not put access tokens in this file. The provider reads the session
# from an already-authenticated Salesforce CLI alias unless both
# SF_INSTANCE_URL and SF_ACCESS_TOKEN are set.

# sf CLI alias. Defaults to the Alchemy --stage name when unset.
# SF_TARGET_ORG=dev

# User who receives the permission set in examples/single-org.ts.
# Must already exist in the org. Not a secret, but it differs per org.
SF_USERNAME=user@example.com

# Optional. Defaults to the apiVersion from `sf org display`, then 68.0.
# SF_API_VERSION=68.0

# Optional CI or static credentials for the default org.
# When both are set, the CLI is not called. Setting only one is an error.
# An explicit targetOrg never uses this pair; give that alias its own
# entry in SF_ORG_CREDENTIALS instead.
# SF_INSTANCE_URL=https://your-domain.my.salesforce.com
# SF_ACCESS_TOKEN=

# Optional client credentials for examples/multi-org.ts.
# Set both or neither. Values are not written to Alchemy state.
# SF_PARTNER_CLIENT_ID=
# SF_PARTNER_CLIENT_SECRET=
